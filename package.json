{
  "name": "payload-plugins",
  "private": true,
  "description": "Payload CMS packages: a Prisma database adapter, and room for more",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "tsc --noEmit -p tsconfig.scripts.json && pnpm -r typecheck",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "dev": "pnpm --filter @repo/blog dev",
    "clean": "pnpm -r exec rm -rf dist node_modules .next && rm -rf node_modules",
    "release": "tsx scripts/release.ts"
  },
  "devDependencies": {
    "@clack/prompts": "1.7.0",
    "@types/node": "catalog:",
    "@types/semver": "7.8.0",
    "semver": "7.8.5",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ],
    "overrides": {
      "graphql": "16.14.2"
    }
  }
}
