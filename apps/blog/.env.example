# Your database.
# The one Prisma owns. Every mapped collection reads and writes through it, and
# Payload creates no table in it.
DATABASE_URL="postgresql://payload:payload@localhost:5433/payload_blog?schema=public"

# Payload's database.
# Admin logins, preferences, document locks, versions, drafts, migrations, the
# job queue, and any global you did not map. None of it belongs in a domain
# schema, so none of it goes there.
PAYLOAD_INTERNAL_URL="mongodb://payload:payload@localhost:27018/payload_internal?authSource=admin"

# Signs Payload's session cookies and reset tokens. Any long random string.
PAYLOAD_SECRET="example-development-secret-change-me"
